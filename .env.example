# Set process environment variables; this file is not silently loaded.
SCOPEDESK_DATABASE_URL=postgresql://USER:PASSWORD@HOST/scopedesk?sslmode=require
SCOPEDESK_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
APP_ENV=production
# Dedicated test database; fixtures create and drop unique scopedesk_test_* schemas.
# SCOPEDESK_TEST_DATABASE_URL=postgresql://...
# SCOPEDESK_BROWSER_PACKAGE=D:/codex/rx-market-pulse/dashboard/package.json

# Required for production: replace with the exact approved deployment/custom hostnames.
# SCOPEDESK_TRUSTED_HOSTS=your-project.vercel.app,your-domain.example
# Fixed HTTPS CRM origin for the handoff navigation; production has no localhost default.
# SCOPEDESK_LOOPDESK_URL=https://your-loopdesk-project.vercel.app
